DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/groundedqa
OPENAI_API_KEY=your-openai-api-key
# OpenAI provider (default). Override base URLs and models to point at another
# OpenAI-compatible endpoint. EMBEDDING_API_KEY/CHAT_API_KEY fall back to
# OPENAI_API_KEY when empty.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_CUTOFF=0.3
MAX_UPLOAD_MB=10
# API key required on /documents and /ask. Leave empty to disable auth (dev only).
API_KEY=
# Tenant ID required when API_KEY is set. X-Tenant-ID header must match this.
TENANT_ID=
# Rate limiter: max requests per window per client IP.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
# Max length of the question body.
MAX_QUESTION_LENGTH=4000
